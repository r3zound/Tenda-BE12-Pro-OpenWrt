# OpenWrt 构建目录（体积巨大，绝不入库）
openwrt/
dl/
build_dir/
staging_dir/
tmp/
bin/
logs/

# 调研原始资料（体积大，按需保留）
!docs/

# 本地配置（可能含宽带凭据）
*.local
config.local
secrets/

# 编辑器
.vscode/
.idea/
*.swp
*~
.DS_Store

# 凭据保护 —— 任何情况下都不要提交
*credentials*
*.secret*
*pppoe-secret*

# Node（仅本地 YAML 校验用，不入库）
node_modules/
package-lock.json
package.json

# ==== 自建 apk 源：绝不能提交的密钥 ====
# 私钥只放 GitHub Actions secrets，注入到 openwrt/private-key.pem
*.pem
# ⚠️ 但**公钥必须提交**（设备靠它信任自建源，这是整个方案的安全锚点）。
#    上一行 *.pem 会把公钥一起挡掉，所以这里显式放行。
!public-key.pem
!**/public-key.pem
!.repo-keys-in-repo/
apk-repo/