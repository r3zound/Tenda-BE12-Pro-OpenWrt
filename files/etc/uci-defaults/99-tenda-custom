#!/bin/sh
# =============================================================================
# /etc/uci-defaults/99-tenda-custom
# -----------------------------------------------------------------------------
# Tenda BE12 Pro 首次启动配置脚本
#
# 执行时机：首次开机，OpenWrt 会依次执行 /etc/uci-defaults/ 下的脚本，
#           成功后自动重命名为 .dpkg-remove 标记文件。
#
# ⚠️ 本脚本不含任何宽带凭据。
# =============================================================================

. /lib/functions.sh

LOG_TAG="tenda-custom"

log()  { logger -t "$LOG_TAG" -p user.info "$*"; echo "$*"; }
warn() { logger -t "$LOG_TAG" -p user.warn "$*"; echo "! $*"; }

# -----------------------------------------------------------------------------
# 1. 软件源切换到国内镜像
#    ⚠️ 源文件路径踩过坑：apk 的源在 /etc/apk/repositories.d/distfeeds.list
#    （distfeeds.list 才是当前 OpenWrt mainline 的实际位置），
#    早期脚本只认 /etc/apk/repositories —— 那个文件**根本不存在**，
#    于是每次都走「未找到，跳过镜像切换」，设备一直用境外官方源。
#    这里两个路径都试一遍，兼容不同版本。
#    切换后记得：`apk update` 重新拉索引。
# -----------------------------------------------------------------------------
switch_mirror() {
	local mirror="${TENDA_MIRROR:-https://mirrors.ustc.edu.cn/openwrt}"
	local repos found=0 cnt

	# ⚠️ 坑 12：这些站**没有同步 snapshots/**，但都对外宣称是「OpenWrt 镜像站」。
	#    清华 TUNA / 北外 BFSU / 南大 NJU / 上交 SJTUG / 中科院 ISCAS 都只镜像 releases，
	#    阿里云 aliyun 同样没有 snapshots —— 填进去会得到 404，
	#    apk 表现为 "unexpected end of file" + "4 unavailable"，一个包装不上。
	#    CERNET 镜像帮助页原话：「部分镜像站(例如 TUNA/BFSU)并不包含 snapshots 镜像，
	#    USTC 提供了对 snapshots 的反代」—— 所以默认必须是 USTC。
	#    官方 downloads.openwrt.org 也一并纳入替换，国内直连慢且不稳。
	local bad="downloads.openwrt.org mirrors.aliyun.com/openwrt mirrors.tuna.tsinghua.edu.cn/openwrt mirrors.bfsu.edu.cn/openwrt mirror.nju.edu.cn/openwrt mirror.sjtug.sjtu.edu.cn/openwrt mirror.iscas.ac.cn/openwrt"

	for repos in /etc/apk/repositories.d/distfeeds.list /etc/apk/repositories; do
		[ -f "$repos" ] || continue
		found=1

		# 先备份，保留回退能力
		[ -f "${repos}.origin" ] || cp "$repos" "${repos}.origin"

		if grep -q "${mirror}" "$repos" && ! grep -qE "${bad}" "$repos"; then
			log "软件源已是 $mirror，跳过 ($repos)"
			continue
		fi

		# 注意：不能只替换 downloads.openwrt.org。
		# 早期版本只替换这一个域名，于是**已经写成 aliyun 的文件永远换不掉**，
		# sed 匹配不到、返回 0、日志照样打「已切换」，实际源纹丝不动。
		local b
		for b in $bad; do
			sed -i "s|https://${b}|${mirror}|g" "$repos"
		done

		# 回读校验：不能只信 sed 的退出码，必须确认坏源真的没了
		if grep -qE "${bad}" "$repos"; then
			warn "镜像切换未完全生效，仍残留坏源 ($repos)"
			grep -E "${bad}" "$repos" | sed 's/^/    /'
		else
			log "软件源已切换至 $mirror ($repos)"
		fi
	done

	if [ "$found" -eq 1 ]; then
		# 换完必须验真的能用：apk update 成功不代表索引有内容
		if apk update >/dev/null 2>&1; then
			cnt=$(apk list 2>/dev/null | wc -l)
			if [ "${cnt:-0}" -gt 1000 ]; then
				log "apk update 成功，可用包 ${cnt} 个"
			else
				warn "apk update 成功但只有 ${cnt} 个包，源可能不完整"
			fi
		else
			warn "apk update 失败，换源后请手动重试"
		fi
	else
		warn "未找到 apk 软件源文件，换源跳过（不影响使用，只是慢）"
	fi
}

# -----------------------------------------------------------------------------
# 1.5 安装自建 apk 源的信任公钥
# -----------------------------------------------------------------------------
# 自建源（r3zound/tenda-repo）用来放代理面板：PassWall / HomeProxy /
# OpenClash / Nikki-RS 等，以及**必须同内核版本编译的 kmod**。
# 源是自签名的，设备要靠 /etc/apk/keys/ 里的公钥才认它，
# 否则每次 apk update 都报 UNTRUSTED signature、索引被丢弃（1 unavailable）。
#
# ⚠️ 为什么不直接把公钥放 files/etc/apk/keys/：
#    那是坑 3 同一个坑 —— /etc/apk/keys 很可能被 apk-tools 声明了文件归属，
#    自定义包直接覆盖会报 "trying to overwrite ... owned by apk-tools"，
#    package/install 整体失败、固件直接产不出来。
#    设备上 `apk audit --system` 又查不出确切归属，不赌它。
#    所以：文件放我们自己的目录（/usr/share/tenda/apk-keys/），
#    首启脚本再 cp 过去 —— 此时是普通文件写入，不走包安装，无归属冲突。
#
# ⚠️ 只覆盖/新增 public-key.pem，**绝不动** openwrt-snapshots.pem
#    （那是官方快照源的签名公钥，动了会导致 apk update 全挂）。
# -----------------------------------------------------------------------------
install_repo_key() {
	local src="/usr/share/tenda/apk-keys/public-key.pem"
	local dst="/etc/apk/keys/public-key.pem"

	[ -f "$src" ] || { warn "未找到自建源公钥 $src（该固件可能不含自建源）"; return 0; }
	[ -d /etc/apk/keys ] || { warn "/etc/apk/keys 不存在，无法安装公钥"; return 0; }

	# 已经装过且内容一致 → 不动，避免每次首启都改 mtime
	if [ -f "$dst" ] && cmp -s "$src" "$dst"; then
		log "自建源公钥已就位"
		return 0
	fi

	if cp -f "$src" "$dst" 2>/dev/null; then
		chmod 0644 "$dst" 2>/dev/null
		log "自建源公钥已安装到 $dst"
	else
		warn "公钥安装失败，自建源需要 apk update --allow-untrusted"
		return 0
	fi

	# 回读校验：cp 返回 0 不等于内容对（坑 9/10/11/12 同一个教训）
	if cmp -s "$src" "$dst"; then
		log "公钥回读校验通过"
	else
		warn "公钥回读不一致，自建源需要 apk update --allow-untrusted"
	fi

	# 官方源的公钥必须还在 —— 动了它 apk update 会全挂
	if [ -f /etc/apk/keys/openwrt-snapshots.pem ]; then
		log "官方快照源公钥未受影响"
	else
		warn "官方快照源公钥不见了！apk update 会失败，检查固件完整性"
	fi
}

# -----------------------------------------------------------------------------
# 2. DHCP / 防火墙 / SSH / 系统配置
# -----------------------------------------------------------------------------
# ⚠️ 为什么这四项不在固件里以 /etc/config/* 文件形式下发，
#    而要在这里用 uci batch 写：
#    apk 严格维护文件归属。/etc/config/dhcp 属于 dnsmasq、
#    /etc/config/dropbear 属于 dropbear、/etc/config/firewall 属于 firewall4，
#    自定义包直接覆盖会报
#        ERROR: trying to overwrite etc/config/dhcp owned by dnsmasq
#    导致 package/install 整体失败、固件产不出来（Run #9 栽在这）。
#    /etc/config/network 没人声明归属，所以它由 tenda-preset 包直接安装。
#
#    首次开机用 uci batch 写入是 OpenWrt 官方发默认配置的正统做法。
# -----------------------------------------------------------------------------
apply_base_config() {
	# ---- DHCP：池 .100-.199，租期 12h，并指向预置网关 ----
	# ⚠️⚠️ `set <包>.<段>=<值>` 在 uci batch 里是**给段赋类型**，不是赋选项值。
	#    这里必须写 'dhcp'。写成 'interface'（或中间那句 =dnsmasq）会把 lan 段的
	#    类型改掉，而 /etc/init.d/dnsmasq 只遍历 `config_foreach ... dhcp`，
	#    于是 LAN 段被整个跳过、不生成 dhcp-range —— 刷完客户端拿不到 IP。
	#    这类错误没有任何报错：uci batch 成功、选项也真的写进去了、脚本末尾的
	#    回读校验照样报 4/4 通过，只有运行后才知道 LAN 不发地址。
	#    验证方法：uci export dhcp | grep '^config' —— 必须看到 config dhcp 'lan'
	uci batch <<-'UCI' 2>/dev/null || warn "uci batch 部分条目失败（可忽略）"
		set dhcp.lan='dhcp'
		set dhcp.lan.interface='lan'
		set dhcp.lan.start='100'
		set dhcp.lan.limit='100'
		set dhcp.lan.leasetime='12h'
		set dhcp.lan.dhcpv4='server'
		set dhcp.lan.ra='server'
		set dhcp.lan.dhcpv6='server'
		set dhcp.lan.ndp='hybrid'
		set dhcp.lan.force='1'
		delete dhcp.lan.dhcp_option
		delete dhcp.odhcpd
		set dhcp.odhcpd='odhcpd'
		set dhcp.odhcpd.maindhcp='0'
	UCI

	# ---- 防火墙：lan / wan+wan2 双出口 ----
	# ⚠️ 不用 @zone[1]/@zone[2] 这种固定匿名索引 —— 官方默认配置里
	#    lan/wan 落在第几个是不保证的（不同版本、不同 base-files 都可能不同），
	#    写死索引轻则改错段、重则把 lan 配成 wan 直接断网。
	#    这里按 zone 的 name 字段反查真实索引。
	local zlan zwan
	zlan="$(uci -q show firewall | sed -n "s/^firewall\.\(@zone\[[0-9]\+\]\)\.name='lan'$/\1/p")"
	zwan="$(uci -q show firewall | sed -n "s/^firewall\.\(@zone\[[0-9]\+\]\)\.name='wan'$/\1/p")"
	[ -z "$zlan" ] && zlan="@zone[0]"
	[ -z "$zwan" ] && zwan="@zone[1]"
	log "防火墙 zone 索引: lan=$zlan  wan=$zwan"

	uci batch <<-UCI 2>/dev/null || warn "uci batch 部分条目失败（可忽略）"
		set firewall.@defaults[0].syn_flood='1'
		set firewall.@defaults[0].input='REJECT'
		set firewall.@defaults[0].output='ACCEPT'
		set firewall.@defaults[0].forward='REJECT'
		set firewall.@defaults[0].drop_invalid='1'
		set firewall.@defaults[0].family='ipv4'

		# ---- ⚠️ 关闭流量卸载：这是 mwan3 负载均衡能生效的前提 ----
		# 实测结论（2026-10-03，设备 192.168.100.254，见 SNAPSHOT固件配置教程/fix-mwan3-balance.sh）：
		#   防火墙的软卸载/硬件卸载会在 **ingress 钩子**把连接直接钉死在链路上，
		#   **完全绕过 mwan3 的 mangle 打标链**，于是 balanced 策略下
		#   几乎只有第一条线跑流量（表现为 wan2 的 rx/tx 长期为几百字节）。
		#   负载均衡与流量卸载**互斥**，必须关掉。
		# 代价：失去 NAT 卸载，转发走 CPU。本机四核 A53 @2.0GHz 扛得住 1G 家用负载。
		# 若更看重转发性能，把 mwan3 策略改成「故障转移」再把这两个改回 1。
		set firewall.@defaults[0].flow_offloading='0'
		set firewall.@defaults[0].flow_offloading_hw='0'

		# fullcone：改善 NAT 类型，对游戏/视频通话/P2P 有帮助。
		# 代价是失去部分隐私性（不再严格隐藏内网地址）。
		set firewall.@defaults[0].fullcone='1'

		set firewall.$zlan.name='lan'
		set firewall.$zlan.network='lan'
		set firewall.$zlan.input='ACCEPT'
		set firewall.$zlan.output='ACCEPT'
		set firewall.$zlan.forward='ACCEPT'
		set firewall.$zwan.name='wan'
		delete firewall.$zwan.network
		add_list firewall.$zwan.network='wan'
		add_list firewall.$zwan.network='wan2'
		set firewall.$zwan.input='REJECT'
		set firewall.$zwan.output='ACCEPT'
		set firewall.$zwan.forward='REJECT'
		set firewall.$zwan.masq='1'
		set firewall.$zwan.mtu_fix='1'
UCI

	# LAN -> wan 放行：按 src/dest 反查，别用固定 @forwarding[0]
	local fwd
	fwd="$(uci -q show firewall | sed -n "s/^firewall\.\(@forwarding\[[0-9]\+\]\)\.src='lan'$/\1/p" | head -1)"
	[ -z "$fwd" ] && fwd="@forwarding[0]"
	uci batch <<-UCI 2>/dev/null || warn "uci batch 部分条目失败（可忽略）"
		set firewall.$fwd.src='lan'
		set firewall.$fwd.dest='wan'
	UCI

	# ---- SSH：允许 root 密码登录（首次装机需要）----
	uci batch <<-'UCI' 2>/dev/null || warn "uci batch 部分条目失败（可忽略）"
		set dropbear.@dropbear[0].PasswordAuth='on'
		set dropbear.@dropbear[0].RootPasswordAuth='on'
		set dropbear.@dropbear[0].Port='22'
	UCI

	# ---- 系统：主机名 / 时区 / NTP ----
	uci batch <<-'UCI' 2>/dev/null || warn "uci batch 部分条目失败（可忽略）"
		set system.@system[0].hostname='Tenda-BE12-Pro'
		set system.@system[0].timezone='CST-8'
		set system.@system[0].zonename='Asia/Shanghai'
		set system.@system[0].log_size='64'
		set system.@system[0].urandom_seed='0'
		set system.ntp=timeserver
		set system.ntp.enabled='1'
		set system.ntp.enable_server='0'
	UCI

	uci commit dhcp
	uci commit firewall
	uci commit dropbear
	uci commit system
	uci commit

	# ---- 结果回读确认 ----
	local ok=0
	[ "$(uci -q get dhcp.lan.start)"   = "100" ]   && ok=$((ok+1))
	[ "$(uci -q get dhcp.lan.limit)"   = "100" ]   && ok=$((ok+1))
	# ⚠️ 这里也必须用动态查到的 $zwan，不能写死 @zone[2]
	uci -q get "firewall.$zwan.network" | grep -q wan2 && ok=$((ok+1))
	[ "$(uci -q get system.@system[0].timezone)" = "CST-8" ] && ok=$((ok+1))
	if [ "$ok" -eq 4 ]; then
		log "DHCP / 防火墙 / SSH / 系统配置已写入（4/4 项确认）"
	else
		warn "配置写入只确认了 $ok/4 项，请进 LuCI 复核"
	fi
}

# -----------------------------------------------------------------------------
# 3. LAN 地址确认
#    预置配置已写入 192.168.100.254，这里做一次兜底校验
# -----------------------------------------------------------------------------
ensure_lan() {
	local ip
	ip="$(uci -q get network.lan.ipaddr)"
	if [ "$ip" != "192.168.100.254" ]; then
		uci set network.lan.ipaddr='192.168.100.254'
		uci set network.lan.netmask='255.255.255.0'
		uci commit network
		log "LAN 地址已修正为 192.168.100.254"
	else
		log "LAN 地址正确: 192.168.100.254"
	fi
}

# -----------------------------------------------------------------------------
# 4. 接口规划校验
#    确保 lan3 未被误加入 LAN 桥（它是 WAN2）
# -----------------------------------------------------------------------------
check_interfaces() {
	local ports
	ports="$(uci -q get network.lan.device)"
	if [ -z "$ports" ]; then
		# 用 bridge device 形式
		ports="$(uci -q get network.@device[0].ports | tr '\n' ' ')"
	fi

	if echo "$ports" | grep -q "lan3"; then
		warn "⚠️ 检测到 lan3 在 LAN 桥中！但 lan3 应作为 WAN2 使用"
		warn "   请检查 /etc/config/network"
	else
		log "接口规划正确: lan3 未加入 LAN 桥"
	fi

	# 确认 eth2 未被加入 LAN 桥
	if echo "$ports" | grep -q "eth2"; then
		warn "⚠️ 检测到 eth2 在 LAN 桥中！eth2 应作为 WAN1 使用"
	fi
}

# -----------------------------------------------------------------------------
# 5. LuCI 主题注册
#    把已安装的主题注册到 /etc/config/luci，确保下拉框里能选到
#
#    LuCI 主题下拉框在「系统 → 系统 → 设计」，数据源是
#    /www/luci-static/resources/view/system/system.js:
#        const th = Object.keys(uci.get('luci','themes') || {}).sort();
#    也就是**只认 luci.themes 段的选项**。段没了/空了，下拉框就是空的。
#
#    ⚠️⚠️ 踩过的坑（坑 11）⚠️⚠️
#    旧版这里写的是：
#        uci -q delete luci.themes
#        uci set luci.themes.$t="/luci-static/$t"     ← 3 段式
#    三个主题包自带的 /etc/uci-defaults/30_luci-theme-* 用 **uci batch**
#    已经把 luci.themes 注册好了，本函数第一行**把它整个删掉**，
#    然后试图用 `uci set` 命令行重建 ——
#    而 `uci set` 的 3 段式在**段不存在时不会自动建段**，
#    会直接报 `uci: Invalid argument` 并返回 1。
#    结果：每一条都失败，uci commit 提交了个空结果，
#    而本函数**没有任何错误检查**，日志照样打「已注册」。
#    表象就是「主题下拉框里无任何主题」，但 CI 全绿、系统一切正常。
#
#    实测对照（同一份 /etc/config/luci，uci 沙箱里跑）：
#        uci set  luci.themes.X=...            → rc=1  uci: Invalid argument
#        uci add luci themes + uci set          → 段建出来了，选项写不进
#        uci batch 里 set luci.themes=themes
#                 + set luci.themes.X=...      → rc=0  ✅
#        uci batch 里直接 3 段式               → rc=0  ✅
#    结论：**只有 batch（以及 uci add）会顺带建段，命令行 set 不会。**
# -----------------------------------------------------------------------------

# 默认主题。用户 2026-10-03 明确要求：eamonxg/luci-theme-aurora 内置且作默认。
# 它已经由 versions.lock 的 THEME_AURORA_* 从
# https://github.com/eamonxg/luci-theme-aurora.git 打进固件了
# （scripts/fetch-extra-packages.sh 直接 clone 到 package/），
# 这里要做的是把它**注册进下拉框**并**设为默认**。
LUCI_DEFAULT_THEME='aurora'

register_themes() {
	local lines="" t key n def

	# 探测真正可用的主题：静态资源目录 + LuCI 模板目录，**两个都要在**。
	# 少任何一个 LuCI 都会回退到 bootstrap（runtime.uc 的 media_error 分支）。
	#
	# ⚠️ 选项名用**驼峰、不带连字符**（BootstrapDark 而不是 bootstrap-dark）：
	#    uci batch 的 `set` 解析器不接受选项名里的 `-`，会静默丢弃该条
	#    （实测：5 个主题只进去 3 个，丢的正好是两个 bootstrap-*）。
	#    这也是官方 30_luci-theme-bootstrap 用 BootstrapDark/BootstrapLight 的原因。
	#    显示名由 LuCI 从选项名直接取（system.js 用 Object.keys 当 label），
	#    所以驼峰名显示为 BootstrapDark，功能上完全等价。
	for t in aurora argon bootstrap bootstrap-dark bootstrap-light; do
		[ -d "/www/luci-static/$t" ] || continue
		[ -d "/usr/share/ucode/luci/template/themes/$t" ] || continue
		case "$t" in
			aurora)          key=Aurora ;;
			argon)           key=Argon ;;
			bootstrap)       key=Bootstrap ;;
			bootstrap-dark)  key=BootstrapDark ;;
			bootstrap-light) key=BootstrapLight ;;
			*)               key="$t" ;;
		esac
		lines="${lines}set luci.themes.${key}='/luci-static/${t}'
"
	done

	if [ -z "$lines" ]; then
		warn "一个 LuCI 主题都没找到，主题下拉框会是空的"
		return
	fi

	# 默认主题回退：aurora 不在就退 argon，再退 bootstrap
	def="$LUCI_DEFAULT_THEME"
	[ -d "/www/luci-static/$def" ] || def=argon
	[ -d "/www/luci-static/$def" ] || def=bootstrap

	# ⚠️ 关键：必须用 batch。batch 里 delete 后可以立刻 set 同名段重建，
	#    命令行 uci set 做不到（见上面的坑 11 说明）。
	#    delete 只在段已存在时才加，避免首启时刷一串 "Entry not found"。
	#
	# ⚠️ 整段用管道送进去，**不要用 <<-EOF 夹变量**：
	#    `<<-` 只剥「here-doc 文本里行首的 TAB」，
	#    而 `$var` 后面紧跟的 TAB 是在展开后才出现的，剥不掉，
	#    结果第一行变成缩进行 → uci: Parse error（踩过）。
	local del=""
	uci -q get luci.themes >/dev/null 2>&1 && del="delete luci.themes
"

	# 管道出口码就是 uci batch 的退出码，可以直接判成败
	{
		printf '%s' "$del"
		echo "set luci.themes=themes"
		printf '%s' "$lines"
		echo "set luci.main.mediaurlbase='/luci-static/${def}'"
		echo "commit luci"
	} | uci batch || {
		warn "uci batch 失败，LuCI 主题下拉框会是空的"
		return
	}

	# ---- 回读校验（坑 9 / 10 / 11 共同的教训：赋值成功 ≠ 生效）--------
	n="$(uci -q show luci 2>/dev/null | grep -c '^luci\.themes\.')"
	if [ "${n:-0}" -ge 1 ]; then
		log "已注册 LuCI 主题 $n 个（$(uci -q show luci 2>/dev/null | grep '^luci\.themes\.' | cut -d. -f3 | sed 's/=.*//' | tr '\n' ' ')），默认 $def"
	else
		warn "luci.themes 回读为 0 项 —— 主题下拉框会是空的，请进 LuCI 手工检查"
	fi
	if [ "$(uci -q get luci.main.mediaurlbase)" = "/luci-static/$def" ]; then
		log "默认主题已设为 $def"
	else
		warn "默认主题设置失败，当前为 $(uci -q get luci.main.mediaurlbase 2>/dev/null)"
	fi
}

# -----------------------------------------------------------------------------
# 6. 无线配置（预置 SSID / 密码 / 加密方式，并默认启用）
#
#    ⚠️⚠️⚠️ 安全警告，**请务必读完** ⚠️⚠️⚠️
#    本仓库是**公开仓库**，下面这个 WiFi 密码会永久留在公开的 git 历史里。
#    任何人都能通过 GitHub 搜到它，也就能连上你家 WiFi。
#    这是明确知情的决定（用户 2026-10-03 确认：「直接写进仓库，我就知道会公开」）。
#    与 §1 的 PPPoE 凭据策略不同 —— 那条不写是因为没必要，这条是用户要的。
#    如果哪天不想公开了，改这一处 + 重新构建即可（但旧值仍留在历史里，
#    彻底清除需要 rewrite history，请另做打算）。
#
#    两频段同名 SSID（ASUS）：客户端按信号强度自行选择 2.4G / 5G，
#    效果等同于漫游，与用户原先 ImmortalWrt 上的用法一致。
#
#    country='CN'：必须设。国内用的是 CN 监管域，不设或设成别的域，
#    5G 的发射功率上限和 DFS 行为都会按错误的法规走
#    （曾出现过 country='AU' 导致 5G 跑到 23 dBm 的情况）。
# -----------------------------------------------------------------------------
WIFI_SSID='ASUS'
WIFI_KEY='abcd1234.'
WIFI_ENC='psk2'          # psk2 = WPA2-PSK (CCMP)；sae 会变成 WPA3

setup_wifi() {
	# ---- 前置自愈：确保 wireless 配置存在且段类型正确 -----------------------
	# files/etc/config/wireless 已经预置了完整配置，正常情况下这里什么都不做。
	# 但如果这个文件被用户/构建过程弄丢了，下面 uci set 会**新建错误类型的伪段**
	# （`uci set wireless.default_radio0.x=1` 在段不存在时会造一个类型叫
	#  default_radio0 的段，不是 wifi-iface，netifd 完全不认），
	# 看起来执行成功、实际零效果 —— 旧的 disable_wifi() 就是这么静默失效的，
	# 设备一度以**无密码开放网络 `OpenWrt`** 上线。
	# 所以先检查，缺就调用官方生成器补上（/sbin/wifi config → mac80211.uc）。
	# 注意 `uci get <包>.<段>` 返回的是**段类型**，所以这一句同时能识破伪段：
	# 伪段会返回 default_radio0 而不是 wifi-device。
	if [ ! -f /etc/config/wireless ] \
	   || [ "$(uci -q get wireless.radio0 2>/dev/null)" != "wifi-device" ] \
	   || [ "$(uci -q get wireless.radio1 2>/dev/null)" != "wifi-device" ]; then
		warn "wireless 配置缺失或段类型不对，调用 /sbin/wifi config 重新生成"
		# ⚠️ 文件在、但段类型不对时**必须先移走**，不能直接让生成器往里补：
		#    mac80211.uc 的 radio_exists(path, macaddr, phy, radio) 是按
		#    `option radio` 索引和 `option path` 匹配的，而本机两个频段
		#    **共用同一条 PCIe path**（soc/11280000.pcie/...），
		#    所以它可能认为「已经有一个 wifi-device 占了」而跳过需要补的那一段，
		#    留下半残配置。移走 → 走「从零生成」这条已验证可靠的路。
		if [ -f /etc/config/wireless ]; then
			mv /etc/config/wireless "/tmp/wireless.broken.$$" 2>/dev/null
		fi
		/sbin/wifi config >/dev/null 2>&1
		# 生成器要等它落盘
		sleep 2
		# 再确认一次：移走之后必须真的生成了正确的段类型
		if [ "$(uci -q get wireless.radio0 2>/dev/null)" != "wifi-device" ] \
		   || [ "$(uci -q get wireless.radio1 2>/dev/null)" != "wifi-device" ]; then
			warn "重新生成后段类型仍不对，请进 LuCI 手工重建无线（备份在 /tmp/wireless.broken.*）"
		fi
	fi

	# ---- 射频：国家码 / 信道 / 带宽 ----------------------------------------
	# 5G 用 36 信道 + 80MHz（避开 100-144 的 DFS 频段，国内无需等待）
	uci set wireless.radio0.country='CN' 2>/dev/null
	uci set wireless.radio0.channel='1' 2>/dev/null
	uci set wireless.radio0.htmode='EHT20' 2>/dev/null
	uci set wireless.radio0.disabled='0' 2>/dev/null

	uci set wireless.radio1.country='CN' 2>/dev/null
	uci set wireless.radio1.channel='36' 2>/dev/null
	uci set wireless.radio1.htmode='EHT80' 2>/dev/null
	uci set wireless.radio1.disabled='0' 2>/dev/null

	# ---- 两个 wifi-iface：同名 SSID + WPA2-PSK -----------------------------
	# 同名 SSID 时客户端按信号强度自行选频段，等效于漫游。
	local r
	for r in default_radio0 default_radio1; do
		uci set wireless.$r.ssid="$WIFI_SSID" 2>/dev/null
		uci set wireless.$r.encryption="$WIFI_ENC" 2>/dev/null
		uci set wireless.$r.key="$WIFI_KEY" 2>/dev/null
		uci set wireless.$r.disabled='0' 2>/dev/null
	done
	uci commit wireless 2>/dev/null

	# ---- 段类型复核（坑 9 / 坑 10 的共同教训：赋值成功 ≠ 段类型对）----------
	local bad_type
	bad_type="$(uci -q export wireless 2>/dev/null | grep -E "^config " | grep -vE "^config (wifi-device|wifi-iface) ")"
	if [ -n "$bad_type" ]; then
		warn "wireless 里出现了非预期的段类型："
		echo "$bad_type" | sed 's/^/      /'
	fi

	# ---- 生效 --------------------------------------------------------------
	reload_config

	# ---- 回读确认（6 项，缺一即告警）--------------------------------------
	# 段类型也纳入回读：只看 uci get 会被伪段骗过去
	local ok=0
	[ "$(uci -q get wireless.default_radio0.ssid)" = "$WIFI_SSID" ] && ok=$((ok+1))
	[ "$(uci -q get wireless.default_radio1.ssid)" = "$WIFI_SSID" ] && ok=$((ok+1))
	[ "$(uci -q get wireless.default_radio0.encryption)" = "$WIFI_ENC" ] && ok=$((ok+1))
	[ "$(uci -q get wireless.default_radio1.encryption)" = "$WIFI_ENC" ] && ok=$((ok+1))
	# country 在 **radio** 上，不在 wifi-iface 上 —— 取错了会永远差 1 分
	[ "$(uci -q get wireless.radio0.country)" = "CN" ] && ok=$((ok+1))
	[ "$(uci -q get wireless.default_radio1.disabled)" = "0" ] && ok=$((ok+1))
	if [ "$ok" -eq 6 ]; then
		log "无线已配置并启用：SSID=$WIFI_SSID 加密=WPA2-PSK（2.4G + 5G 同名）"
	else
		warn "无线配置只确认了 $ok/6 项，请进 LuCI 复核"
	fi
	warn "⚠ WiFi 密码是写在公开仓库里的默认值，建议尽快在 LuCI 里改成你自己的"
}

# -----------------------------------------------------------------------------
# 7. 安装 mwan3（原生 nft 移植版）
#    ⚠️ 刻意不打进固件镜像 —— 原因见 README §4.3
#    首次启动尝试联网安装；失败则输出提示，不阻塞启动
# -----------------------------------------------------------------------------
try_install_mwan3() {
	if command -v mwan3 >/dev/null 2>&1; then
		log "mwan3 已安装，跳过"
		return 0
	fi

	log "尝试安装 mwan3（原生 nft 移植版）…"
	# ⚠️ 失败很正常（GitHub Releases 在大陆时通时不通），**不要阻塞启动**。
	#    这里只记录日志，用户之后手动跑一次即可。
	local out rc
	out="$(sh /usr/lib/tenda/install-mwan3.sh 2>&1)"; rc=$?
	printf '%s\n' "$out" | while read -r line; do
		logger -t "$LOG_TAG" -p user.info "$line"
	done
	if [ $rc -ne 0 ] || ! command -v mwan3 >/dev/null 2>&1; then
		warn "mwan3 自动安装未成功（多为 GitHub 不通）。联网后手动执行："
		warn "  sh /usr/lib/tenda/install-mwan3.sh"
	fi
}

# -----------------------------------------------------------------------------
# 7b. 关闭 frpc 开机自启
#    luci-app-frpc 的出厂默认里 server_addr='127.0.0.1'，是**占位值**——
#    frpc 会去连路由器自己，必然失败。再叠加 login_fail_exit='true'
#    和 respawn='1'，就是无限崩溃循环（实测 Run #15 刷完 6 次 crash loop）。
#    真正的服务端地址要用户自己填，所以这里先关掉自启，避免无意义的重启风暴。
# -----------------------------------------------------------------------------
disable_frpc_autostart() {
	[ -f /etc/config/frpc ] || return 0
	local addr
	addr="$(uci -q get frpc.common.server_addr 2>/dev/null)"
	if [ "$addr" = "127.0.0.1" ] || [ -z "$addr" ]; then
		uci set frpc.@init[0].enabled='0' 2>/dev/null
		uci commit frpc 2>/dev/null
		/etc/init.d/frpc stop 2>/dev/null
		/etc/init.d/frpc disable 2>/dev/null
		log "frpc 已保持关闭（server_addr 是占位默认值，需在 LuCI 填真实服务端后再启用）"
	fi
}

# -----------------------------------------------------------------------------
# 8. 硬件信息记录
# -----------------------------------------------------------------------------
log_hardware() {
	echo "=== Tenda BE12 Pro 硬件信息 ===" > /etc/tenda-hardware.txt
	echo "构建版本: $(cat /etc/openwrt_release 2>/dev/null | tr '\n' ' ')" >> /etc/tenda-hardware.txt
	echo "启动时间: $(date)" >> /etc/tenda-hardware.txt
	echo "" >> /etc/tenda-hardware.txt
	echo "--- 接口 ---" >> /etc/tenda-hardware.txt
	ip link show >> /etc/tenda-hardware.txt 2>&1
	echo "" >> /etc/tenda-hardware.txt
	echo "--- 无线天线配置 ---" >> /etc/tenda-hardware.txt
	grep -E 'antenna_(rx|tx)' /etc/board.json >> /etc/tenda-hardware.txt 2>&1
	echo "" >> /etc/tenda-hardware.txt
	echo "--- WED 状态 ---" >> /etc/tenda-hardware.txt
	{
		ls /sys/kernel/debug/mtk_wed/ 2>&1
		ls /sys/kernel/debug/ieee80211/phy0/mt7996e/ 2>&1
	} >> /etc/tenda-hardware.txt
	echo "" >> /etc/tenda-hardware.txt
	echo "--- mtd 分区 ---" >> /etc/tenda-hardware.txt
	cat /proc/mtd >> /etc/tenda-hardware.txt 2>&1
	log "硬件信息已记录到 /etc/tenda-hardware.txt"
}

