#!/bin/sh
# =============================================================================
# /etc/uci-defaults/99-tenda-custom
# -----------------------------------------------------------------------------
# Tenda BE12 Pro 首次启动配置脚本
#
# 执行时机：首次开机，OpenWrt 会依次执行 /etc/uci-defaults/ 下的脚本，
#           成功后自动重命名为 .dpkg-remove 标记文件。
#
# ⚠️ 本脚本不含任何宽带凭据。
# =============================================================================

. /lib/functions.sh

LOG_TAG="tenda-custom"

log()  { logger -t "$LOG_TAG" -p user.info "$*"; echo "$*"; }
warn() { logger -t "$LOG_TAG" -p user.warn "$*"; echo "! $*"; }

# -----------------------------------------------------------------------------
# 1. 软件源切换到国内镜像
#    OpenWrt 25.12+ 使用 apk。官方源在 /etc/apk/repositories，
#    这里替换为阿里云（可用环境变量 TENDA_MIRROR 覆盖）。
# -----------------------------------------------------------------------------
switch_mirror() {
	local repos=/etc/apk/repositories
	[ -f "$repos" ] || { warn "未找到 $repos，跳过镜像切换"; return 0; }

	local mirror="${TENDA_MIRROR:-https://mirrors.aliyun.com/openwrt}"
	# 先备份，保留回退能力
	[ -f "${repos}.origin" ] || cp "$repos" "${repos}.origin"

	if sed -i "s|https://downloads\.openwrt\.org|${mirror}|g" "$repos"; then
		log "软件源已切换至: $mirror"
	else
		warn "镜像切换失败，保持官方源"
	fi
}

# -----------------------------------------------------------------------------
# 2. DHCP / 防火墙 / SSH / 系统配置
# -----------------------------------------------------------------------------
# ⚠️ 为什么这四项不在固件里以 /etc/config/* 文件形式下发，
#    而要在这里用 uci batch 写：
#    apk 严格维护文件归属。/etc/config/dhcp 属于 dnsmasq、
#    /etc/config/dropbear 属于 dropbear、/etc/config/firewall 属于 firewall4，
#    自定义包直接覆盖会报
#        ERROR: trying to overwrite etc/config/dhcp owned by dnsmasq
#    导致 package/install 整体失败、固件产不出来（Run #9 栽在这）。
#    /etc/config/network 没人声明归属，所以它由 tenda-preset 包直接安装。
#
#    首次开机用 uci batch 写入是 OpenWrt 官方发默认配置的正统做法。
# -----------------------------------------------------------------------------
apply_base_config() {
	# ---- DHCP：池 .100-.199，租期 12h，并指向预置网关 ----
	uci batch <<-'UCI' 2>/dev/null || warn "uci batch 部分条目失败（可忽略）"
		set dhcp.lan=dnsmasq
		set dhcp.lan='interface'
		set dhcp.lan.interface='lan'
		set dhcp.lan.start='100'
		set dhcp.lan.limit='100'
		set dhcp.lan.leasetime='12h'
		set dhcp.lan.dhcpv4='server'
		set dhcp.lan.ra='server'
		set dhcp.lan.dhcpv6='server'
		set dhcp.lan.ndp='hybrid'
		set dhcp.lan.force='1'
		delete dhcp.lan.dhcp_option
		delete dhcp.odhcpd
		set dhcp.odhcpd='odhcpd'
		set dhcp.odhcpd.maindhcp='0'
	UCI

	# ---- 防火墙：lan / wan+wan2 双出口 ----
	# ⚠️ 不用 @zone[1]/@zone[2] 这种固定匿名索引 —— 官方默认配置里
	#    lan/wan 落在第几个是不保证的（不同版本、不同 base-files 都可能不同），
	#    写死索引轻则改错段、重则把 lan 配成 wan 直接断网。
	#    这里按 zone 的 name 字段反查真实索引。
	local zlan zwan
	zlan="$(uci -q show firewall | sed -n "s/^firewall\.\(@zone\[[0-9]\+\]\)\.name='lan'$/\1/p")"
	zwan="$(uci -q show firewall | sed -n "s/^firewall\.\(@zone\[[0-9]\+\]\)\.name='wan'$/\1/p")"
	[ -z "$zlan" ] && zlan="@zone[0]"
	[ -z "$zwan" ] && zwan="@zone[1]"
	log "防火墙 zone 索引: lan=$zlan  wan=$zwan"

	uci batch <<-UCI 2>/dev/null || warn "uci batch 部分条目失败（可忽略）"
		set firewall.@defaults[0].syn_flood='1'
		set firewall.@defaults[0].input='REJECT'
		set firewall.@defaults[0].output='ACCEPT'
		set firewall.@defaults[0].forward='REJECT'
		set firewall.@defaults[0].drop_invalid='1'
		set firewall.@defaults[0].family='ipv4'
		set firewall.$zlan.name='lan'
		set firewall.$zlan.network='lan'
		set firewall.$zlan.input='ACCEPT'
		set firewall.$zlan.output='ACCEPT'
		set firewall.$zlan.forward='ACCEPT'
		set firewall.$zwan.name='wan'
		delete firewall.$zwan.network
		add_list firewall.$zwan.network='wan'
		add_list firewall.$zwan.network='wan2'
		set firewall.$zwan.input='REJECT'
		set firewall.$zwan.output='ACCEPT'
		set firewall.$zwan.forward='REJECT'
		set firewall.$zwan.masq='1'
		set firewall.$zwan.mtu_fix='1'
UCI

	# LAN -> wan 放行：按 src/dest 反查，别用固定 @forwarding[0]
	local fwd
	fwd="$(uci -q show firewall | sed -n "s/^firewall\.\(@forwarding\[[0-9]\+\]\)\.src='lan'$/\1/p" | head -1)"
	[ -z "$fwd" ] && fwd="@forwarding[0]"
	uci batch <<-UCI 2>/dev/null || warn "uci batch 部分条目失败（可忽略）"
		set firewall.$fwd.src='lan'
		set firewall.$fwd.dest='wan'
	UCI

	# ---- SSH：允许 root 密码登录（首次装机需要）----
	uci batch <<-'UCI' 2>/dev/null || warn "uci batch 部分条目失败（可忽略）"
		set dropbear.@dropbear[0].PasswordAuth='on'
		set dropbear.@dropbear[0].RootPasswordAuth='on'
		set dropbear.@dropbear[0].Port='22'
	UCI

	# ---- 系统：主机名 / 时区 / NTP ----
	uci batch <<-'UCI' 2>/dev/null || warn "uci batch 部分条目失败（可忽略）"
		set system.@system[0].hostname='Tenda-BE12-Pro'
		set system.@system[0].timezone='CST-8'
		set system.@system[0].zonename='Asia/Shanghai'
		set system.@system[0].log_size='64'
		set system.@system[0].urandom_seed='0'
		set system.ntp=timeserver
		set system.ntp.enabled='1'
		set system.ntp.enable_server='0'
	UCI

	uci commit dhcp
	uci commit firewall
	uci commit dropbear
	uci commit system
	uci commit

	# ---- 结果回读确认 ----
	local ok=0
	[ "$(uci -q get dhcp.lan.start)"   = "100" ]   && ok=$((ok+1))
	[ "$(uci -q get dhcp.lan.limit)"   = "100" ]   && ok=$((ok+1))
	# ⚠️ 这里也必须用动态查到的 $zwan，不能写死 @zone[2]
	uci -q get "firewall.$zwan.network" | grep -q wan2 && ok=$((ok+1))
	[ "$(uci -q get system.@system[0].timezone)" = "CST-8" ] && ok=$((ok+1))
	if [ "$ok" -eq 4 ]; then
		log "DHCP / 防火墙 / SSH / 系统配置已写入（4/4 项确认）"
	else
		warn "配置写入只确认了 $ok/4 项，请进 LuCI 复核"
	fi
}

# -----------------------------------------------------------------------------
# 3. LAN 地址确认
#    预置配置已写入 192.168.100.254，这里做一次兜底校验
# -----------------------------------------------------------------------------
ensure_lan() {
	local ip
	ip="$(uci -q get network.lan.ipaddr)"
	if [ "$ip" != "192.168.100.254" ]; then
		uci set network.lan.ipaddr='192.168.100.254'
		uci set network.lan.netmask='255.255.255.0'
		uci commit network
		log "LAN 地址已修正为 192.168.100.254"
	else
		log "LAN 地址正确: 192.168.100.254"
	fi
}

# -----------------------------------------------------------------------------
# 4. 接口规划校验
#    确保 lan3 未被误加入 LAN 桥（它是 WAN2）
# -----------------------------------------------------------------------------
check_interfaces() {
	local ports
	ports="$(uci -q get network.lan.device)"
	if [ -z "$ports" ]; then
		# 用 bridge device 形式
		ports="$(uci -q get network.@device[0].ports | tr '\n' ' ')"
	fi

	if echo "$ports" | grep -q "lan3"; then
		warn "⚠️ 检测到 lan3 在 LAN 桥中！但 lan3 应作为 WAN2 使用"
		warn "   请检查 /etc/config/network"
	else
		log "接口规划正确: lan3 未加入 LAN 桥"
	fi

	# 确认 eth2 未被加入 LAN 桥
	if echo "$ports" | grep -q "eth2"; then
		warn "⚠️ 检测到 eth2 在 LAN 桥中！eth2 应作为 WAN1 使用"
	fi
}

# -----------------------------------------------------------------------------
# 5. LuCI 主题注册
#    把已安装的主题注册到 /etc/config/luci，确保下拉框里能选到
# -----------------------------------------------------------------------------
register_themes() {
	local themes="bootstrap"
	local t

	for t in /usr/share/luci/menu.d/luci-theme-*; do
		[ -e "$t" ] || continue
	done

	# 探测实际存在的主题目录
	for t in argon aurora edge bootstrap; do
		if [ -d "/www/luci-static/$t" ]; then
			themes="$themes $t"
		fi
	done

	uci -q delete luci.themes 2>/dev/null
	for t in $themes; do
		uci set luci.themes.$t="/luci-static/$t"
	done

	# 默认主题：bootstrap 最稳，argon 次之
	if [ -d /www/luci-static/bootstrap ]; then
		uci set luci.main.mediaurlbase='/luci-static/bootstrap'
	fi
	uci commit luci
	log "已注册 LuCI 主题:$themes（默认 bootstrap）"
}

# -----------------------------------------------------------------------------
# 6. 无线默认关闭
#    安全策略：首次启动不广播 SSID，用户配置后再启用
# -----------------------------------------------------------------------------
disable_wifi() {
	uci set wireless.default_radio0.disabled='1' 2>/dev/null
	uci set wireless.default_radio1.disabled='1' 2>/dev/null
	uci commit wireless 2>/dev/null
	log "无线已默认关闭，请配置 SSID 后于 LuCI 中启用"
}

# -----------------------------------------------------------------------------
# 7. 安装 mwan3（原生 nft 移植版）
#    ⚠️ 刻意不打进固件镜像 —— 原因见 README §4.3
#    首次启动尝试联网安装；失败则输出提示，不阻塞启动
# -----------------------------------------------------------------------------
try_install_mwan3() {
	if command -v mwan3 >/dev/null 2>&1; then
		log "mwan3 已安装，跳过"
		return 0
	fi

	log "尝试安装 mwan3（原生 nft 移植版）…"
	sh /usr/lib/tenda/install-mwan3.sh 2>&1 | while read -r line; do
		logger -t "$LOG_TAG" -p user.info "$line"
	done
}

# -----------------------------------------------------------------------------
# 8. 硬件信息记录
# -----------------------------------------------------------------------------
log_hardware() {
	echo "=== Tenda BE12 Pro 硬件信息 ===" > /etc/tenda-hardware.txt
	echo "构建版本: $(cat /etc/openwrt_release 2>/dev/null | tr '\n' ' ')" >> /etc/tenda-hardware.txt
	echo "启动时间: $(date)" >> /etc/tenda-hardware.txt
	echo "" >> /etc/tenda-hardware.txt
	echo "--- 接口 ---" >> /etc/tenda-hardware.txt
	ip link show >> /etc/tenda-hardware.txt 2>&1
	echo "" >> /etc/tenda-hardware.txt
	echo "--- 无线天线配置 ---" >> /etc/tenda-hardware.txt
	grep -E 'antenna_(rx|tx)' /etc/board.json >> /etc/tenda-hardware.txt 2>&1
	echo "" >> /etc/tenda-hardware.txt
	echo "--- WED 状态 ---" >> /etc/tenda-hardware.txt
	{
		ls /sys/kernel/debug/mtk_wed/ 2>&1
		ls /sys/kernel/debug/ieee80211/phy0/mt7996e/ 2>&1
	} >> /etc/tenda-hardware.txt
	echo "" >> /etc/tenda-hardware.txt
	echo "--- mtd 分区 ---" >> /etc/tenda-hardware.txt
	cat /proc/mtd >> /etc/tenda-hardware.txt 2>&1
	log "硬件信息已记录到 /etc/tenda-hardware.txt"
}

# =============================================================================
# 执行
# =============================================================================
log "首次启动配置开始…"

switch_mirror
apply_base_config
ensure_lan
check_interfaces
register_themes
disable_wifi
log_hardware
try_install_mwan3

log "首次启动配置完成"
exit 0
