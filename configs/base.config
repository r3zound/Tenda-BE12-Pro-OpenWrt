# ============================================================================
# Tenda BE12 Pro — OpenWrt 核心构建配置
# ----------------------------------------------------------------------------
# 基线：官方 OpenWrt mainline SNAPSHOT（见 versions.lock）
# 目标：mediatek/filogic / tenda_be12-pro
#
# ⚠️ 不要手工改 .config —— 改这里，然后跑 scripts/gen-config.sh 重新生成。
# ============================================================================

# ---- Target ----------------------------------------------------------------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_tenda_be12-pro=y
# ⚠️ 不要设 CONFIG_TARGET_MULTI_PROFILE —— 它是 choice 的另一分支，
#    与「指定单一设备」冲突，会导致上面那行被 override 掉：
#      .config:warning: override: TARGET_MULTI_PROFILE changes choice state
#    多设备构建才用它；本项目只出一个机型。

# ---- Rootfs ----------------------------------------------------------------
# 官方镜像配方使用 squashfs + UBI，本项目保持一致
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS_ZSTD=y

# ---- Subtarget 调优 --------------------------------------------------------
# MT7987A 四核 A53，适度提高并发
CONFIG_TARGET_OPTIMIZATION_SIZE=y
CONFIG_MIPS32_24KC=n

# ---- LuCI 基础 -------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-ssl=y

# ---- LuCI 主题 -------------------------------------------------------------
# 官方主线只有 bootstrap / footstrap / material / openwrt / openwrt-2020
# argon / aurora / edge 均为第三方，见 scripts/gen-feeds.sh
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-aurora=y
# luci-theme-edge 已移除，原因见 versions.lock 注释
CONFIG_PACKAGE_luci-app-argon-config=y

# ---- 常用 LuCI 模块 --------------------------------------------------------
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-firewall=y
CONFIG_PACKAGE_luci-mod-dhcp=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_luci-app-statistics=y

# ---- mwan3 运行时依赖（必须在固件里）---------------------------------------
# ⚠️ 这个 kmod 不是给 mwan3 用的，是给 **mwan3 的依赖链**用的：
#    mwan3 → libnetfilter-conntrack3 → kmod-nf-conntrack-netlink
#    少一个，apk 就报 "no such package" 直接拒绝安装 mwan3。
#
#    为什么不能靠刷机后现装：本机构建出来的 /etc/apk/repositories.d/distfeeds.list
#    **只有 4 个 feed，没有 kmods feed**（实测索引里 kmod 条目只有 3 个），
#    也就是说刷完机之后任何内核模块都装不了。只能打进固件。
#    Run #15 实机验证：没这个 kmod 时 `apk add mwan3.apk` 直接失败。
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y

# ---- 透明代理命门 -----------------------------------------------------------
# ⚠️ 上面那段注释说「刷完机之后任何内核模块都装不了」—— 这正是这两个必须
#    **打进固件**而不是丢进自建源的原因：用户刷完机第一次想装 PassWall，
#    OpenClash 或 HomeProxy，如果它依赖的 kmod 只能从自建源拿，就得先手工
#    配 customfeeds.list 才能装上代理 —— 门槛太高，而且 kmod 一旦和内核
#    对不上就是 vermagic 失败、面板直接起不来。
#
#    kmod-nft-tproxy    nftables 的 TPROXY target —— TPROXY 模式的命门
#    kmod-nft-socket    nftables 的 socket 匹配族，透明代理的流量标记要用
#
#    两者都很小（几十 KB），换透明代理能开箱可用，值。
#    其余面板依赖（sing-box / mihomo / xray 等 noarch 包）走自建源即可，
#    它们不绑内核版本，不存在 vermagic 问题。
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y

# ---- FRP 内网穿透 ----------------------------------------------------------
# frp 守护进程来自 openwrt/packages 官方包（v0.71.0，Go 编译）
# luci-app-frpc 同样用官方 luci feed 的包（含 htdocs/po/root，已声明 +frpc）CONFIG_PACKAGE_frpc=y
CONFIG_PACKAGE_frps=n
CONFIG_PACKAGE_luci-app-frpc=y

# ---- 预置配置（关键，务必保留）-------------------------------------------
# 这个包把 files/ 下的 /etc/config/*、/etc/uci-defaults/99-tenda-custom、
# /usr/lib/tenda/install-mwan3.sh 打进固件。
# ⚠️ 没有它，固件就是官方默认配置：管理地址是 192.168.1.1（不是 192.168.100.254）、
#    双 WAN 接口划分（eth2=WAN1 / lan3=WAN2）不存在、阿里云源没切、
#    mwan3 安装助手也没有。
CONFIG_PACKAGE_tenda-preset=y

# ---- 基础工具 --------------------------------------------------------------
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_vim=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_tree=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-ipt-nat-extra=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_kmod-libipsec=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_ip-tiny=y

# ---- 网络协议与加速 --------------------------------------------------------
CONFIG_PACKAGE_pppd=y
CONFIG_PACKAGE_ppp-mod-ppp_generic=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-tun=y

# ---- 硬件相关 --------------------------------------------------------------
# 官方 Device/tenda_be12-pro 已自动带入以下包，无需重复声明：
#   mt7987-2p5g-phy-firmware
#   airoha-en8811h-firmware
#   kmod-phy-airoha-en8811h
#   kmod-mt7992-firmware
CONFIG_PACKAGE_ethtool=y

# ---- 内核 / 系统 -----------------------------------------------------------
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_lede=y

# ---- 关闭不需要的东西，节省空间 --------------------------------------------
# 本机无 USB 口，存储/下载类应用全部无意义，直接不编译
CONFIG_PACKAGE_luci-app-ddns=n
CONFIG_PACKAGE_luci-app-transmission=n
CONFIG_PACKAGE_luci-app-samba=n
CONFIG_PACKAGE_luci-app-nas=n
CONFIG_PACKAGE_luci-app-docker=n
CONFIG_PACKAGE_dockerd=n
CONFIG_PACKAGE_containerd=n
CONFIG_PACKAGE_runc=n
CONFIG_PACKAGE_luci-mod-docker=n

# ---- 构建行为 --------------------------------------------------------------
CONFIG_DEVEL=n
CONFIG_AUTOREBOOT=n
CONFIG_BUILD_CONFIGURED=n
